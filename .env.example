# Leave both empty to run in Local Demo Mode (localStorage + 15 seeded posts).
# Fill both to switch to the live Supabase backend with realtime.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: public URL of the deployed site, e.g. https://kalesh.vercel.app
# Used for share links, the "Post to X" intent and the card watermark.
# Defaults to the current origin.
VITE_SITE_URL=
